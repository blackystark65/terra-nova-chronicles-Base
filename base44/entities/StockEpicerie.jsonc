{
  "name": "StockEpicerie",
  "type": "object",
  "properties": {
    "produit_id": {
      "type": "string",
      "description": "ID du produit"
    },
    "nom": {
      "type": "string",
      "description": "Nom du produit"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji du produit"
    },
    "rayon": {
      "type": "string",
      "description": "Rayon (serre, fruits, legumes, viandes, etc.)"
    },
    "quantite": {
      "type": "number",
      "default": 0,
      "description": "Quantit\u00e9 en stock"
    },
    "prix": {
      "type": "number",
      "description": "Prix unitaire"
    },
    "derniere_livraison": {
      "type": "string",
      "description": "Date de la derni\u00e8re livraison"
    }
  },
  "required": [
    "produit_id",
    "nom",
    "rayon"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}